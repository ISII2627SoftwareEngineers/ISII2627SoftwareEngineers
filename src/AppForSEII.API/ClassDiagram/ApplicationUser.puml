@startuml
class ApplicationUser {
    + ApplicationUser()
    + ApplicationUser(id:string, name:string, surname:string, userName:string)
    + Name : string? <<get>> <<set>>
    + Surname : string? <<get>> <<set>>
    + Resenas : IList<Resena> <<get>> <<set>>
    + Compras : IList<Compra> <<get>> <<set>>
    + Reposiciones : IList<Reposicion> <<get>> <<set>>
}
ApplicationUser "1" -- "0..* Resenas" Resena

'para caso de uso comprar libros
ApplicationUser "1" -- "0..* Compras" Compra

ApplicationUser "1" -- "0..* Reposicion" Reposicion 


IdentityUser <|-- ApplicationUser
@enduml
