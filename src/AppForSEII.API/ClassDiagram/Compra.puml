@startuml
class Compra {
    + Compra()
    + Compra(id:int, fechaCompra:DateTime, precioTotal:double, codigoDescuento:string, metodoPago:MetodoPago, compraItems:IList<CompraItem>, usuario:ApplicationUser)
    + Id : int <<get>> <<set>>
    + FechaCompra : DateTime <<get>> <<set>>
    + PrecioTotal : double <<get>> <<set>>
    + CodigoDescuento : string <<get>> <<set>>
    + MetodoPago : MetodoPago <<get>> <<set>>
    + CompraItems : IList<CompraItem> <<get>> <<set>>
    + Usuario : ApplicationUser <<get>> <<set>>
}
