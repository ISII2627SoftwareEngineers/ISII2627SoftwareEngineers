@startuml
class Reposicion {
    + Reposicion()
    + Reposicion(id:int, fechaReposicion:DateTime, precioTotal:decimal, comentario:string?, reposicionItems:IList<ReposicionItem>, metodosPago:IList<MetodoPago>, usuario:ApplicationUser)
    + Id : int <<get>> <<set>>
    + FechaReposicion : DateTime <<get>> <<set>>
    + PrecioTotal : decimal <<get>> <<set>>
    + Comentario : string? <<get>> <<set>>
    + ReposicionItems : IList<ReposicionItem> <<get>> <<set>>
    + MetodosPago : IList<MetodoPago> <<get>> <<set>>
    + Usuario : ApplicationUser <<get>> <<set>>
    + <<override>> Equals(obj:object?) : bool
    + <<override>> GetHashCode() : int
}
@enduml
